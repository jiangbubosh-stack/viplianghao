# 后台管理员密码（务必修改！否则谁都能进后台上传/删除）
ADMIN_PASSWORD=admin888

# 监听端口（云平台会自动注入 PORT，本地默认 3000）
PORT=3000

# 绑定地址（容器/云环境通常是 0.0.0.0，本地一般不用改）
HOST=0.0.0.0

# 数据目录：云平台请指向「持久卷」挂载路径（如 /data），否则重启/重部署后号码会清空！
# 本地不填则用项目内的 ./data
# DATA_DIR=/data

# 允许访问的来源，逗号分隔。默认 * 允许所有（本地/同域使用）。生产可填 https://yourdomain.com
ALLOWED_ORIGINS=*
